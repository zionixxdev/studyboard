# StudyBoard — environment template.
# Copy to .env and fill in. These are the ONLY values the frontend needs.
# The anon/publishable key is public-safe; NEVER put the service_role key here.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: a TURN relay for WebRTC on restrictive networks (see README §8).
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
