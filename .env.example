# ---------------------------------------------------------------------------
# StudyBoard — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase "anon" public key (Project Settings -> API -> Project API keys -> anon public)
# This key is SAFE to ship in the frontend. It is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The URL the app is served from. Used to build email-confirmation and
# password-reset redirect links. For local dev this is the Vite dev server.
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# DO NOT add the Supabase service_role key here.
# The service_role key bypasses Row Level Security and must NEVER reach the
# browser. It is only ever used inside trusted server-side contexts
# (Supabase Edge Functions / SQL functions), configured in the Supabase
# dashboard, not in this frontend bundle.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Voice chat (optional). WebRTC needs a STUN server at minimum, and a TURN
# relay for users behind symmetric NATs / restrictive corporate or mobile
# networks. STUN is free; TURN usually costs money or needs self-hosting.
# See docs/SETUP.md and docs/LIMITATIONS.md.
# ---------------------------------------------------------------------------
VITE_STUN_URL=stun:stun.l.google.com:19302
# Leave VITE_TURN_URL / credentials blank to run voice without a relay.
# Voice will then fail for some network pairs — this is expected and documented.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
